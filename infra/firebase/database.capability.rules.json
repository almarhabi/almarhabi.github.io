{
  "rules": {
    ".read": false,
    ".write": false,
    "users": {
      "$syncKey": {
        ".read": "$syncKey.matches(/^[A-Za-z0-9_-]{20,768}$/)",
        ".write": "$syncKey.matches(/^[A-Za-z0-9_-]{20,768}$/)"
      }
    },
    "audio": {
      "$syncKey": {
        ".read": "$syncKey.matches(/^[A-Za-z0-9_-]{20,768}$/)",
        ".write": "$syncKey.matches(/^[A-Za-z0-9_-]{20,768}$/)"
      }
    }
  }
}
